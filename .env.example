# Локально: данные хранятся в ./data
DATA_DIR=./data

# Сессия остаётся активной год; можно поставить от 1 до 3650 дней
SESSION_MAX_AGE_DAYS=365

# Рекомендуется задать собственный случайный секрет (не публиковать его)
# Если не задан, сервер создаст файл session-secret в DATA_DIR.
# SESSION_SECRET=

# Необязательные данные администратора при первом запуске
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-password
