# Включите PostgreSQL только после создания базы Neon и копирования pooled URL в Render Environment.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require

# Установите в Render; используйте длинную случайную строку, не публикуйте её.
# SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_MAX_AGE_DAYS=365
PG_POOL_MAX=5

# Путь к старой SQLite-базе, если она ещё доступна при первом PostgreSQL запуске.
# LEGACY_SQLITE_PATH=./data/game.db

ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-password
